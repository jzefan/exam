# Copy this file to:
#   /home/leishuo/exam-app/shared/env/backend.env
# and fill in real values on the server.
#
# scripts/deploy.sh never uploads a real backend.env from your local machine.

EXAM_DATABASE_URL=postgresql+asyncpg://exam:replace-this-password@db:5432/exam
EXAM_SECRET_KEY=replace-this-with-a-long-random-string
EXAM_DEBUG=false
EXAM_CORS_ORIGINS=["http://146.56.224.80:3036"]
EXAM_FRONTEND_BASE_URL=http://146.56.224.80:3036

# Database pool sizing. Each uvicorn worker owns one pool, and blue/green
# deployments can temporarily run two backend slots. Keep these modest unless
# PostgreSQL max_connections or PgBouncer capacity has been increased.
EXAM_DATABASE_POOL_SIZE=10
EXAM_DATABASE_MAX_OVERFLOW=10
EXAM_DATABASE_POOL_RECYCLE_SECONDS=14400
EXAM_DATABASE_WARM_POOL=true

# Password reset email. Leave SMTP blank to disable email-based reset.
EXAM_PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
EXAM_SMTP_HOST=
EXAM_SMTP_PORT=587
EXAM_SMTP_USERNAME=
EXAM_SMTP_PASSWORD=
EXAM_SMTP_FROM_EMAIL=
EXAM_SMTP_USE_TLS=true

# Optional AI provider settings. Leave blank if unused.
EXAM_DEEPSEEK_API_KEY=
EXAM_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
EXAM_DEEPSEEK_MODEL_NAME=deepseek-v4-flash

EXAM_QWEN_API_KEY=
EXAM_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EXAM_QWEN_MODEL_NAME=qwen-plus
EXAM_QWEN_VL_MODEL_NAME=qwen-vl-plus

EXAM_KIMI_API_KEY=
EXAM_KIMI_BASE_URL=https://api.moonshot.cn/v1
EXAM_KIMI_MODEL_NAME=moonshot-v1-8k

EXAM_OPENROUTER_API_KEY=
EXAM_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
EXAM_OPENROUTER_MODEL_NAME=anthropic/claude-3.5-sonnet
