# Optional deploy-time overrides.
# Copy this file to:
#   /home/leishuo/exam-app/shared/env/deploy.env
# Only set values you actually need.

# Stable compose project name.
COMPOSE_PROJECT_NAME=exam-app

# If the server cannot access Docker Hub directly, switch images to a mirror.
# Example mirror values that often work better on mainland China networks:
# POSTGRES_IMAGE=docker.m.daocloud.io/library/postgres:17-alpine
# NGINX_IMAGE=docker.m.daocloud.io/library/nginx:1.27-alpine
# PYTHON_BASE_IMAGE=docker.m.daocloud.io/library/python:3.12-slim
# NODE_BASE_IMAGE=docker.m.daocloud.io/library/node:22-alpine
# FRONTEND_NGINX_IMAGE=docker.m.daocloud.io/library/nginx:1.27-alpine

# Dependency mirrors used inside docker build.
# Note: the target server can be Ubuntu, but python:3.12-slim itself is Debian-based,
# so the apt mirror below is a Debian mirror for the container image, not the host OS.
# These defaults are already set in docker-compose.yml, but keeping them here
# makes it easy to switch sources without changing code.
# If deploy repeatedly stalls during `uv sync --frozen --no-dev`, the first thing to try
# is switching these mirrors to a source that is faster from the target server network.
# DEBIAN_APT_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/debian
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# UV_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# PNPM_REGISTRY=https://registry.npmmirror.com
