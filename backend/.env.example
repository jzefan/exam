EXAM_DATABASE_URL=postgresql+asyncpg://exam:exam@localhost:5432/exam
EXAM_SECRET_KEY=dev-secret-key
EXAM_DEBUG=true
EXAM_CORS_ORIGINS=["http://localhost:4000"]

# When judge-runner is started by `docker compose -f docker-compose.dev.yml up -d judge_runner`,
# local backend development can call the container through this URL.
EXAM_JUDGE_RUNNER_URL=http://127.0.0.1:8010

# When lsp-runner is started by `docker compose -f docker-compose.dev.yml up -d lsp_runner`,
# local backend development can proxy code-question language service sessions through this URL.
EXAM_LSP_RUNNER_URL=http://127.0.0.1:8020

# ArkLoop OIDC / MCP integration.
# Production MCP should run with streamable-http so ArkLoop can inject a fresh
# teacher Bearer token on every CallTool request. The MCP adapter verifies this
# RS256 token first, then forwards it to the normal exam REST boundary so
# permissions, ownership isolation, versioning, and activity logs remain there.
ARKLOOP_OIDC_ISSUER=http://localhost:19000
EXAM_MCP_EXPECTED_AUD=exam-web
EXAM_OIDC_ISSUER=http://localhost:19000
EXAM_OIDC_CLIENT_ID=exam-web
EXAM_OIDC_CLIENT_SECRET=
EXAM_AGENT_BASE_URL=http://localhost:8000
EXAM_AGENT_MCP_TRANSPORT=streamable-http
EXAM_AGENT_MCP_HOST=127.0.0.1
EXAM_AGENT_MCP_PORT=8001
EXAM_AGENT_MCP_PATH=/mcp

# Optional local-only fallback for stdio development. Do not use as the
# production identity source because it makes all MCP calls share one user.
# EXAM_AGENT_TOKEN=
# EXAM_MCP_ALLOW_STATIC_TOKEN=false

# Read-only service credential for national/reference question bank reads.
# Only exam_list_reference_questions uses this token; all write tools still use
# the acting teacher Bearer and always write to that teacher's course bank.
# EXAM_REFERENCE_ADMIN_TOKEN=
# EXAM_REFERENCE_QUESTION_BANK_ID=
# EXAM_REFERENCE_ADMIN_ORG_ID=
